# Firebase web app configuration. These values identify the public web client;
# they are not Firebase Admin/server credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Set true only when running the local Firebase Auth emulator.
VITE_FIREBASE_USE_EMULATORS=false
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
